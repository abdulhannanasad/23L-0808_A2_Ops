# --- DagsHub / MLflow (training + fetching the champion) ---
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/23L-0808_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>
# --- Database ---
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=visionguard
# --- Web app ---
MODEL_PATH=/models/best.keras
THRESHOLD=0.5
MAX_UPLOAD_MB=5
# local sqlite fallback (used when running outside Docker)
DATABASE_URL=sqlite:///visionguard.db
# --- Task 7/8: remote model API (leave empty to use local model) ---
MODEL_API_URL=
MODEL_API_KEY=change-me
